# Copy to .env (git-ignored) and fill in. NEVER commit a real .env.
#
# The full Postgres DSN for the Tiger Cloud dev service. In the pipeline this is
# read from AWS Secrets Manager (agentic-dataops/app/database-url). Locally,
# paste the Tiger connection string (password from your Tiger keyring).
# NOT localhost — always a Tiger Cloud service.
DATABASE_URL="postgresql://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require"

# Web server port (the ALB target port). Default 8080.
PORT="8080"

# Optional: point the app at a specific schema (used to demonstrate reading the
# OLD vs NEW table shape during a zero-downtime migration). Default: public.
APP_SCHEMA_VERSION="public"

# Ingest loop tuning (live-traffic-during-migration demo).
INGEST_RATE_PER_SEC="5"
INGEST_DURATION_SEC="0"   # 0 = run until stopped

# Seed harness. SEED_ROWS rows into sensor_readings; SEED_SEQ_START optionally
# resets the id sequence near the int4 ceiling (2147483647) so overflow is
# imminent at the 1M scaled boundary. Leave SEED_SEQ_START empty to skip.
SEED_ROWS="1000000"
SEED_SEQ_START=""
SEED_DEVICES="1000"

# Datadog seams — OFF by default (monitoring is a later phase).
DD_ENABLED="false"
